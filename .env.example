# ------------------------------------------------------------------------------
# VERCEL EDGE CONFIG
# ------------------------------------------------------------------------------
# Vercel Dashboard -> Storage -> Edge Config -> 'Copy Connection String'
EDGE_CONFIG="your_edge_config_connection_string_with_token"

# Edge Config ID (e.g., ecfg_...)
EDGE_CONFIG_ID="your_edge_config_id_here"

# Vercel Personal Access Token (Account Settings -> Tokens)
# Required for writing data to Edge Config via API
VERCEL_ACCESS_TOKEN="your_vercel_personal_access_token"

# ------------------------------------------------------------------------------
# WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Public key for the client-side (PWA)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your_public_vapid_key_here"

# Private key for the server-side (DO NOT expose to client)
VAPID_PRIVATE_KEY="your_private_vapid_key_here"

# Usually a mailto: or website URL
VAPID_SUBJECT="mailto:iletisim@yourdomain.org"

# ------------------------------------------------------------------------------
# EMAIL SERVICE (RESEND)
# ------------------------------------------------------------------------------
RESEND_API_KEY="re_your_resend_api_key"

# ------------------------------------------------------------------------------
# DATABASE (SUPABASE / POSTGRES)
# ------------------------------------------------------------------------------
# Connection string for Strapi or your custom backend
# Format: postgres://user:password@host:port/database
DATABASE_URL="postgres://postgres:password@db.your-ref.supabase.co:5432/postgres"
